# ORCA / Sagar Mitra backend - environment template
# ======================================================
# Copy this file to .env in the same folder (backend/.env) and fill in
# your real values. NEVER commit the real .env file to git (it's already
# in .gitignore).
#
#   cp .env.example .env        # macOS/Linux
#   copy .env.example .env      # Windows

# --- REQUIRED --------------------------------------------------------------
# Without this, app/main.py refuses to start (see app/advisory.py's
# require_gemini_key) instead of silently running with every advisory
# degraded to the raw-data fallback formatter.
#
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- OPTIONAL ----------------------------------------------------------
# Comma-separated list of additional free-tier keys. When one hits its
# quota mid-request, ORCA automatically rotates to the next key and
# retries instead of failing the request. If set, this takes priority
# over the single GEMINI_API_KEY above.
# GEMINI_API_KEYS=key_one,key_two,key_three

# Overrides the default path to the historical Argo dataset used by
# app/data.py and app/historical.py.
# SAGAR_MITRA_DATA_PATH=./data/final_dataset.parquet

# Restricts CORS to specific origins instead of the wide-open "*" default
# (see app/main.py) -- set this before deploying anywhere public.
# SAGAR_MITRA_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Base URL used to build clickable links for generated historical-chart
# images (see app/historical.py). Defaults to the local dev server; set
# this to your real deployed URL once hosted.
# SAGAR_MITRA_BASE_URL=http://127.0.0.1:8000
